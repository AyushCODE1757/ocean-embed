{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanembed.earth/schemas/metrics.schema.json",
  "title": "OceanEmbed Comprehensive Evaluation Metrics Schema",
  "type": "object",
  "required": ["run_id", "model_name", "test_period", "overall", "per_depth", "per_basin", "per_season", "independence_caveat"],
  "properties": {
    "run_id": { "type": "string" },
    "model_name": { "type": "string" },
    "test_period": { "type": "string" },
    "overall": {
      "type": "object",
      "required": ["rmse", "mae", "bias", "pearson_r", "acc", "skill_score_clim", "d20_rmse", "d26_rmse", "ohc_rmse"],
      "properties": {
        "rmse": { "type": "number" },
        "mae": { "type": "number" },
        "bias": { "type": "number" },
        "pearson_r": { "type": "number" },
        "acc": { "type": "number" },
        "skill_score_clim": { "type": "number" },
        "std_ratio": { "type": "number" },
        "d20_rmse": { "type": "number" },
        "d26_rmse": { "type": "number" },
        "ohc_rmse": { "type": "number" }
      }
    },
    "per_depth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["depth", "rmse", "mae", "bias", "pearson_r", "acc", "skill_score_clim"],
        "properties": {
          "depth": { "type": "number" },
          "rmse": { "type": "number" },
          "mae": { "type": "number" },
          "bias": { "type": "number" },
          "pearson_r": { "type": "number" },
          "acc": { "type": "number" },
          "skill_score_clim": { "type": "number" }
        }
      }
    },
    "per_basin": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rmse": { "type": "number" },
          "mae": { "type": "number" },
          "bias": { "type": "number" },
          "pearson_r": { "type": "number" },
          "acc": { "type": "number" },
          "skill_score_clim": { "type": "number" }
        }
      }
    },
    "per_season": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rmse": { "type": "number" },
          "mae": { "type": "number" },
          "bias": { "type": "number" },
          "pearson_r": { "type": "number" },
          "acc": { "type": "number" },
          "skill_score_clim": { "type": "number" }
        }
      }
    },
    "baselines": {
      "type": "object"
    },
    "argo_validation": {
      "type": "object"
    },
    "independence_caveat": { "type": "string" }
  }
}
