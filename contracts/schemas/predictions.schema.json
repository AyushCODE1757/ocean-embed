{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanembed.earth/schemas/predictions.schema.json",
  "title": "OceanEmbed Model Prediction Output Schema",
  "type": "object",
  "required": ["date", "temp_mean_shape", "temp_logvar_shape", "depths", "grid"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "temp_mean_shape": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 3,
      "maxItems": 4
    },
    "temp_logvar_shape": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 3,
      "maxItems": 4
    },
    "embedding_shape": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "depths": { "type": "array", "items": { "type": "number" }, "minItems": 15, "maxItems": 15 },
    "grid": {
      "type": "object",
      "properties": {
        "lat_count": { "type": "integer", "const": 101 },
        "lon_count": { "type": "integer", "const": 241 }
      }
    }
  }
}
