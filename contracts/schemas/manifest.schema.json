{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanembed.earth/schemas/manifest.schema.json",
  "title": "OceanEmbed Ingestion Manifest Schema",
  "type": "object",
  "required": ["version", "generated_at", "total_files", "files"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "total_files": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset_id", "variable", "filename", "sha256", "bytes", "source_tier", "date_range"],
        "properties": {
          "dataset_id": { "type": "string" },
          "variable": { "type": "string" },
          "source_url": { "type": "string" },
          "doi": { "type": "string" },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "source_tier": { "type": "string", "enum": ["final", "interim", "nrt", "fixture"] },
          "date_range": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
