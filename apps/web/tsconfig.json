{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "ES2022"], "module": "esnext",
    "moduleResolution": "bundler", "jsx": "preserve", "strict": true,
    "noEmit": true, "skipLibCheck": true, "incremental": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}
