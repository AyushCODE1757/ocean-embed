# OceanEmbed API configuration (copy to .env and adjust).
# All paths are relative to the repository root.

# Predictions store written by scripts/build_artifacts.py from B's model export.
OE_PREDICTIONS_PATH=artifacts/predictions/current/predictions.zarr
# Evaluation metrics written by scripts/build_artifacts.py (sanitized results/ JSONs).
OE_METRICS_PATH=artifacts/eval/metrics.json
# Run manifest (provenance) written by scripts/build_artifacts.py.
OE_MANIFEST_PATH=runs/current/run_manifest.json
# Advisor outputs (gaps/, osse.json). Present only if the ensemble run landed;
# the API returns 503 with a reason while they are absent - never fake data.
OE_ADVISOR_DIR=artifacts/advisor
# Raw Argo profiles used for the profile overlay (B's export, QC-filtered).
OE_ARGO_PATH=data/app_data/argo.parquet
# Processed IBTrACS cyclone tracks. Unset -> packaged reference (Remal, Fengal 2024).
# OE_CYCLONES_PATH=artifacts/cyclones/cyclones.json

# Identity of the served run (shown in the UI status bar).
OE_MODEL_ID=oceanembed-e1-v1
OE_RUN_ID=kaggle-v1-2025

# CORS: web app origin(s).
OE_CORS_ORIGINS=["http://localhost:3000"]
